# CominAI — variáveis de ambiente
# Copie este arquivo para .env e preencha com suas chaves.

# Obrigatório: chave da Anthropic para os agentes Claude
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Opcional: Proxycurl para enriquecimento automático do LinkedIn em produção
PROXYCURL_API_KEY=

# Opcional: Google Calendar (Agente 2 — em desenvolvimento)
GOOGLE_CALENDAR_CREDENTIALS_PATH=

# Opcional: Quickin / Slack / Coderbyte para integrações via n8n
QUICKIN_WEBHOOK_SECRET=
SLACK_WEBHOOK_URL=
CODERBYTE_API_KEY=
